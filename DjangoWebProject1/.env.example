# Copy to .env outside Git. Generate independent random production credentials.
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=instrumentpsk.ru,www.instrumentpsk.ru
CSRF_TRUSTED_ORIGINS=https://instrumentpsk.ru,https://www.instrumentpsk.ru
SECURE_HSTS_SECONDS=3600
DATABASE_URL=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=InstrumentPSK <your-sender@gmail.com>
# The db service reads a separate .env.db file (chmod 600):
# POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD.
# For an existing database, updating the file does not rotate the database role.
# ALTER ROLE must be coordinated with updating DATABASE_URL and restarting web.
